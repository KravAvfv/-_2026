%% Варіант 8 «Розумна енергомережа (Smart Grid)» — ПР1 «Теорія систем»
%% Лінії: товста (===) — канал із шифруванням, суцільна — частковий захист, пунктир — без шифрування;
%% товста рамка — точка зчленування графа (єдина точка відмови).
graph TB
  classDef cut stroke:#000,stroke-width:4px;
  subgraph L1["Вимірювання"]
    E1["Е1<br/>Квартирні<br/>лічильники (72)"]
    E2["Е2<br/>Загальнобудинкові<br/>лічильники (3)"]
    E3["Е3<br/>Ввідний<br/>лічильник"]
  end
  subgraph L2["Збір і передавання"]
    E5["Е5<br/>УЗПД"]
    E6["Е6<br/>LTE-маршрутизатор"]
  end
  subgraph L3["Застосування"]
    E7["Е7<br/>Сервер АСКОЕ"]
    E8["Е8<br/>АРМ управителя"]
    E9["Е9<br/>Застосунок<br/>мешканця"]
  end
  subgraph L4["Зовнішнє середовище"]
    PPKO(["ППКО"])
    OSR(["ОСР"])
  end
  E1 -. "RS-485" .- E5
  E2 -. "RS-485" .- E5
  E5 -. "Ethernet" .- E7
  E5 -. "Ethernet" .- E6
  E6 -- "LTE APN" --- PPKO
  E3 -- "GSM" --- OSR
  E7 -. "HTTP" .- E8
  E7 == "HTTPS" === E9
  class E5,E7,E6 cut;
