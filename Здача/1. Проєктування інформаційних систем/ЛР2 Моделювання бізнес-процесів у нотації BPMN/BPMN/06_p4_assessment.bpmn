<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_d6_assessment" targetNamespace="http://knu.ua/pis/shchyt-link" exporter="tools/bpmn_model.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_d6_assessment">
    <bpmn:participant id="P3c6" name="Виконання місії перехоплення"/>
    <bpmn:participant id="X_AF6" name="Вищий командний пункт (Повітряні сили ЗСУ)"/>
    <bpmn:participant id="P4" name="Оцінка результату та звітність" processRef="Proc_P4"/>
    <bpmn:participant id="X_DSNS" name="ДСНС"/>
    <bpmn:messageFlow id="MF_d6_assessment_0" sourceRef="P3c6" targetRef="P4_s" name="Доповідь про результат"/>
    <bpmn:messageFlow id="MF_d6_assessment_1" sourceRef="P4_t3" targetRef="X_AF6" name="Звіт про перехоплення"/>
    <bpmn:messageFlow id="MF_d6_assessment_2" sourceRef="P4_t4" targetRef="X_DSNS" name="Координати падіння"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_P4" isExecutable="false">
    <bpmn:laneSet id="LS_P4">
      <bpmn:lane id="P4_L1" name="Оперативний черговий">
        <bpmn:flowNodeRef>P4_t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P4_L2" name="Аналітик обстановки">
        <bpmn:flowNodeRef>P4_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P4_L3" name="Офіцер взаємодії">
        <bpmn:flowNodeRef>P4_t4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P4_s" name="Доповідь отримано"><bpmn:outgoing>SF_P4_0</bpmn:outgoing><bpmn:messageEventDefinition id="ED_P4_s"/></bpmn:startEvent>
    <bpmn:serviceTask id="P4_t1" name="Зібрати докази: відео, дані сенсорів"><bpmn:incoming>SF_P4_0</bpmn:incoming><bpmn:outgoing>SF_P4_1</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P4_t2" name="Встановити оцінку результату"><bpmn:incoming>SF_P4_1</bpmn:incoming><bpmn:outgoing>SF_P4_2</bpmn:outgoing><bpmn:dataOutputAssociation id="DOA_P4_t2_0"><bpmn:targetRef>P4_d1</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask>
    <bpmn:inclusiveGateway id="P4_g1" name=""><bpmn:incoming>SF_P4_2</bpmn:incoming><bpmn:outgoing>SF_P4_3</bpmn:outgoing><bpmn:outgoing>SF_P4_4</bpmn:outgoing></bpmn:inclusiveGateway>
    <bpmn:sendTask id="P4_t3" name="Надіслати звіт вищому КП"><bpmn:incoming>SF_P4_3</bpmn:incoming><bpmn:outgoing>SF_P4_5</bpmn:outgoing></bpmn:sendTask>
    <bpmn:sendTask id="P4_t4" name="Повідомити ДСНС про місце падіння уламків"><bpmn:incoming>SF_P4_4</bpmn:incoming><bpmn:outgoing>SF_P4_6</bpmn:outgoing></bpmn:sendTask>
    <bpmn:inclusiveGateway id="P4_g2" name=""><bpmn:incoming>SF_P4_5</bpmn:incoming><bpmn:incoming>SF_P4_6</bpmn:incoming><bpmn:outgoing>SF_P4_7</bpmn:outgoing></bpmn:inclusiveGateway>
    <bpmn:endEvent id="P4_e" name="Звіт оформлено"><bpmn:incoming>SF_P4_7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_P4_0" sourceRef="P4_s" targetRef="P4_t1" name=""/>
    <bpmn:sequenceFlow id="SF_P4_1" sourceRef="P4_t1" targetRef="P4_t2" name=""/>
    <bpmn:sequenceFlow id="SF_P4_2" sourceRef="P4_t2" targetRef="P4_g1" name=""/>
    <bpmn:sequenceFlow id="SF_P4_3" sourceRef="P4_g1" targetRef="P4_t3" name="завжди"/>
    <bpmn:sequenceFlow id="SF_P4_4" sourceRef="P4_g1" targetRef="P4_t4" name="є уламки"/>
    <bpmn:sequenceFlow id="SF_P4_5" sourceRef="P4_t3" targetRef="P4_g2" name=""/>
    <bpmn:sequenceFlow id="SF_P4_6" sourceRef="P4_t4" targetRef="P4_g2" name=""/>
    <bpmn:sequenceFlow id="SF_P4_7" sourceRef="P4_g2" targetRef="P4_e" name=""/>
    <bpmn:dataStoreReference id="P4_d1" name="Архів місій"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Dgm_d6_assessment"><bpmndi:BPMNPlane id="Plane_d6_assessment" bpmnElement="Collab_d6_assessment">
    <bpmndi:BPMNShape id="P3c6_di" bpmnElement="P3c6" isHorizontal="true"><dc:Bounds x="0" y="0" width="576" height="64"/></bpmndi:BPMNShape>
