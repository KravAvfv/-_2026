<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_d2_assignment_a" targetNamespace="http://knu.ua/pis/shchyt-link" exporter="tools/bpmn_model.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_d2_assignment_a">
    <bpmn:participant id="X_AF" name="Вищий командний пункт (Повітряні сили ЗСУ)"/>
    <bpmn:participant id="P2" name="Призначення цілі та санкціонування пуску (частина 1)" processRef="Proc_P2"/>
    <bpmn:participant id="P1c" name="Моніторинг повітряної обстановки"/>
    <bpmn:messageFlow id="MF_d2_assignment_a_0" sourceRef="P2_tc" targetRef="X_AF" name="Запит на погодження"/>
    <bpmn:messageFlow id="MF_d2_assignment_a_1" sourceRef="P1c" targetRef="P2_s" name="Підтверджена ціль"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_P2" isExecutable="false">
    <bpmn:laneSet id="LS_P2">
      <bpmn:lane id="P2_L1" name="Офіцер взаємодії">
        <bpmn:flowNodeRef>P2_tc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_ec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_L2" name="Офіцер бойового управління">
        <bpmn:flowNodeRef>P2_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_L3" name="Оперативний черговий">
        <bpmn:flowNodeRef>P2_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_lk</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P2_s" name="Ціль отримано"><bpmn:outgoing>SF_P2_0</bpmn:outgoing><bpmn:messageEventDefinition id="ED_P2_s"/></bpmn:startEvent>
    <bpmn:serviceTask id="P2_t1" name="Перевірити зони заборони і плани польотів"><bpmn:incoming>SF_P2_0</bpmn:incoming><bpmn:outgoing>SF_P2_1</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P2_g1" name="Конфлікт?"><bpmn:incoming>SF_P2_1</bpmn:incoming><bpmn:outgoing>SF_P2_2</bpmn:outgoing><bpmn:outgoing>SF_P2_3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P2_tc" name="Погодити перехоплення з ПС ЗСУ"><bpmn:incoming>SF_P2_2</bpmn:incoming><bpmn:outgoing>SF_P2_4</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P2_ec" name="Перехоплення відкладено"><bpmn:incoming>SF_P2_4</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="P2_t2" name="Обрати розрахунок-кандидат"><bpmn:incoming>SF_P2_3</bpmn:incoming><bpmn:incoming>SF_P2_6</bpmn:incoming><bpmn:outgoing>SF_P2_5</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P2_t3" name="Санкціонувати пуск (правило двох осіб)"><bpmn:incoming>SF_P2_5</bpmn:incoming><bpmn:outgoing>SF_P2_7</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P2_g2" name="Дозволено?"><bpmn:incoming>SF_P2_7</bpmn:incoming><bpmn:outgoing>SF_P2_6</bpmn:outgoing><bpmn:outgoing>SF_P2_8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="P2_lk" name="До частини 2 (А)"><bpmn:incoming>SF_P2_8</bpmn:incoming><bpmn:linkEventDefinition id="ED_P2_lk" name="А"/></bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="SF_P2_0" sourceRef="P2_s" targetRef="P2_t1" name=""/>
    <bpmn:sequenceFlow id="SF_P2_1" sourceRef="P2_t1" targetRef="P2_g1" name=""/>
    <bpmn:sequenceFlow id="SF_P2_2" sourceRef="P2_g1" targetRef="P2_tc" name="так"/>
    <bpmn:sequenceFlow id="SF_P2_3" sourceRef="P2_g1" targetRef="P2_t2" name="ні"/>
    <bpmn:sequenceFlow id="SF_P2_4" sourceRef="P2_tc" targetRef="P2_ec" name=""/>
    <bpmn:sequenceFlow id="SF_P2_5" sourceRef="P2_t2" targetRef="P2_t3" name=""/>
    <bpmn:sequenceFlow id="SF_P2_6" sourceRef="P2_g2" targetRef="P2_t2" name="ні"/>
    <bpmn:sequenceFlow id="SF_P2_7" sourceRef="P2_t3" targetRef="P2_g2" name=""/>
    <bpmn:sequenceFlow id="SF_P2_8" sourceRef="P2_g2" targetRef="P2_lk" name="так"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Dgm_d2_assignment_a"><bpmndi:BPMNPlane id="Plane_d2_assignment_a" bpmnElement="Collab_d2_assignment_a">
    <bpmndi:BPMNShape id="X_AF_di" bpmnElement="X_AF" isHorizontal="true"><dc:Bounds x="0" y="0" width="1052" height="64"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P2_di" bpmnElement="P2" isHorizontal="true"><dc:Bounds x="0" y="104" width="1052" height="354"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P2_L1_di" bpmnElement="P2_L1" isHorizontal="true"><dc:Bounds x="50" y="104" width="1002" height="118"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P2_L2_di" bpmnElement="P2_L2" isHorizontal="true"><dc:Bounds x="50" y="222" width="1002" height="118"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P2_L3_di" bpmnElement="P2_L3" isHorizontal="true"><dc:Bounds x="50" y="340" width="1002" height="118"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P2_s_di" bpmnElement="P2_s"><dc:Bounds x="136" y="261" width="40" height="40"/><bpmndi:BPMNLabel><dc:Bounds x="104" y="221" width="104" height="38"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P2_t1_di" bpmnElement="P2_t1"><dc:Bounds x="214" y="237" width="164" height="88"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P2_g1_di" bpmnElement="P2_g1"><dc:Bounds x="409" y="254" width="54" height="54"/><bpmndi:BPMNLabel><dc:Bounds x="384" y="311" width="104" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P2_tc_di" bpmnElement="P2_tc"><dc:Bounds x="494" y="119" width="164" height="88"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P2_ec_di" bpmnElement="P2_ec"><dc:Bounds x="740" y="143" width="40" height="40"/><bpmndi:BPMNLabel><dc:Bounds x="705" y="186" width="110" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P2_t2_di" bpmnElement="P2_t2"><dc:Bounds x="494" y="237" width="164" height="88"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P2_t3_di" bpmnElement="P2_t3"><dc:Bounds x="678" y="355" width="164" height="88"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P2_g2_di" bpmnElement="P2_g2"><dc:Bounds x="873" y="372" width="54" height="54"/><bpmndi:BPMNLabel><dc:Bounds x="820" y="349" width="160" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P2_lk_di" bpmnElement="P2_lk"><dc:Bounds x="976" y="379" width="40" height="40"/><bpmndi:BPMNLabel><dc:Bounds x="944" y="422" width="104" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P1c_di" bpmnElement="P1c" isHorizontal="true"><dc:Bounds x="0" y="498" width="1052" height="64"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="SF_P2_0_di" bpmnElement="SF_P2_0"><di:waypoint x="176" y="281"/><di:waypoint x="214" y="281"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_P2_1_di" bpmnElement="SF_P2_1"><di:waypoint x="378" y="281"/><di:waypoint x="409" y="281"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_P2_2_di" bpmnElement="SF_P2_2"><di:waypoint x="436" y="254"/><di:waypoint x="436" y="163"/><di:waypoint x="494" y="163"/><bpmndi:BPMNLabel><dc:Bounds x="441" y="232" width="32" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_P2_3_di" bpmnElement="SF_P2_3"><di:waypoint x="463" y="281"/><di:waypoint x="494" y="281"/><bpmndi:BPMNLabel><dc:Bounds x="469" y="259" width="23" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_P2_4_di" bpmnElement="SF_P2_4"><di:waypoint x="658" y="163"/><di:waypoint x="740" y="163"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_P2_5_di" bpmnElement="SF_P2_5"><di:waypoint x="658" y="281"/><di:waypoint x="668" y="281"/><di:waypoint x="668" y="399"/><di:waypoint x="678" y="399"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_P2_6_di" bpmnElement="SF_P2_6"><di:waypoint x="900" y="426"/><di:waypoint x="900" y="450"/><di:waypoint x="576" y="450"/><di:waypoint x="576" y="325"/><bpmndi:BPMNLabel><dc:Bounds x="905" y="428" width="23" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_P2_7_di" bpmnElement="SF_P2_7"><di:waypoint x="842" y="399"/><di:waypoint x="873" y="399"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_P2_8_di" bpmnElement="SF_P2_8"><di:waypoint x="927" y="399"/><di:waypoint x="976" y="399"/><bpmndi:BPMNLabel><dc:Bounds x="933" y="377" width="32" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="MF_d2_assignment_a_0_di" bpmnElement="MF_d2_assignment_a_0"><di:waypoint x="606" y="119"/><di:waypoint x="606" y="64"/><bpmndi:BPMNLabel><dc:Bounds x="612" y="73" width="163" height="22"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="MF_d2_assignment_a_1_di" bpmnElement="MF_d2_assignment_a_1"><di:waypoint x="156" y="498"/><di:waypoint x="156" y="301"/><bpmndi:BPMNLabel><dc:Bounds x="162" y="467" width="146" height="22"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
