<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_d3_assignment_b" targetNamespace="http://knu.ua/pis/shchyt-link" exporter="tools/bpmn_model.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_d3_assignment_b">
    <bpmn:participant id="P2b" name="Призначення цілі та санкціонування пуску (частина 2)" processRef="Proc_P2b"/>
    <bpmn:participant id="P3c" name="Виконання місії перехоплення"/>
    <bpmn:messageFlow id="MF_d3_assignment_b_0" sourceRef="P2b_t1" targetRef="P3c" name="Бойове завдання"/>
    <bpmn:messageFlow id="MF_d3_assignment_b_1" sourceRef="P3c" targetRef="P2b_i1" name="Підтвердження прийняття"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_P2b" isExecutable="false">
    <bpmn:laneSet id="LS_P2b">
      <bpmn:lane id="P2b_L1" name="Офіцер бойового управління">
        <bpmn:flowNodeRef>P2b_lk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2b_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2b_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2b_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2b_i2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2b_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2b_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2b_L2" name="Оперативний черговий">
        <bpmn:flowNodeRef>P2b_t3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:intermediateCatchEvent id="P2b_lk" name="З частини 1 (А)"><bpmn:outgoing>SF_P2b_0</bpmn:outgoing><bpmn:linkEventDefinition id="ED_P2b_lk" name="А"/></bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="P2b_t1" name="Передати бойове завдання розрахунку"><bpmn:incoming>SF_P2b_0</bpmn:incoming><bpmn:incoming>SF_P2b_7</bpmn:incoming><bpmn:outgoing>SF_P2b_1</bpmn:outgoing></bpmn:sendTask>
    <bpmn:eventBasedGateway id="P2b_gw" name=""><bpmn:incoming>SF_P2b_1</bpmn:incoming><bpmn:outgoing>SF_P2b_2</bpmn:outgoing><bpmn:outgoing>SF_P2b_3</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="P2b_i1" name="Прийняття підтверджено"><bpmn:incoming>SF_P2b_2</bpmn:incoming><bpmn:outgoing>SF_P2b_4</bpmn:outgoing><bpmn:messageEventDefinition id="ED_P2b_i1"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P2b_i2" name="15 с без відповіді"><bpmn:incoming>SF_P2b_3</bpmn:incoming><bpmn:outgoing>SF_P2b_6</bpmn:outgoing><bpmn:timerEventDefinition id="ED_P2b_i2"/></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="P2b_t2" name="Зафіксувати призначення цілі"><bpmn:incoming>SF_P2b_4</bpmn:incoming><bpmn:outgoing>SF_P2b_5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P2b_e" name="Ціль призначено"><bpmn:incoming>SF_P2b_5</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="P2b_t3" name="Обрати резервний розрахунок"><bpmn:incoming>SF_P2b_6</bpmn:incoming><bpmn:outgoing>SF_P2b_7</bpmn:outgoing></bpmn:userTask>
    <bpmn:sequenceFlow id="SF_P2b_0" sourceRef="P2b_lk" targetRef="P2b_t1" name=""/>
    <bpmn:sequenceFlow id="SF_P2b_1" sourceRef="P2b_t1" targetRef="P2b_gw" name=""/>
    <bpmn:sequenceFlow id="SF_P2b_2" sourceRef="P2b_gw" targetRef="P2b_i1" name=""/>
    <bpmn:sequenceFlow id="SF_P2b_3" sourceRef="P2b_gw" targetRef="P2b_i2" name=""/>
    <bpmn:sequenceFlow id="SF_P2b_4" sourceRef="P2b_i1" targetRef="P2b_t2" name=""/>
    <bpmn:sequenceFlow id="SF_P2b_5" sourceRef="P2b_t2" targetRef="P2b_e" name=""/>
    <bpmn:sequenceFlow id="SF_P2b_6" sourceRef="P2b_i2" targetRef="P2b_t3" name=""/>
    <bpmn:sequenceFlow id="SF_P2b_7" sourceRef="P2b_t3" targetRef="P2b_t1" name=""/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Dgm_d3_assignment_b"><bpmndi:BPMNPlane id="Plane_d3_assignment_b" bpmnElement="Collab_d3_assignment_b">
