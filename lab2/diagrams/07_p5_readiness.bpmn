    <bpmndi:BPMNShape id="P5_g2_di" bpmnElement="P5_g2"><dc:Bounds x="689" y="372" width="54" height="54"/><bpmndi:BPMNLabel><dc:Bounds x="664" y="429" width="104" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P5_t5_di" bpmnElement="P5_t5"><dc:Bounds x="774" y="355" width="164" height="88"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P5_e2_di" bpmnElement="P5_e2"><dc:Bounds x="976" y="379" width="40" height="40"/><bpmndi:BPMNLabel><dc:Bounds x="944" y="422" width="104" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P5_e1_di" bpmnElement="P5_e1"><dc:Bounds x="976" y="261" width="40" height="40"/><bpmndi:BPMNLabel><dc:Bounds x="941" y="304" width="110" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="SF_P5_0_di" bpmnElement="SF_P5_0"><di:waypoint x="176" y="163"/><di:waypoint x="214" y="163"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_P5_1_di" bpmnElement="SF_P5_1"><di:waypoint x="296" y="207"/><di:waypoint x="296" y="237"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_P5_2_di" bpmnElement="SF_P5_2"><di:waypoint x="378" y="281"/><di:waypoint x="409" y="281"/></bpmndi:BPMNEdge>
