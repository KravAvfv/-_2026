<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_d7_readiness" targetNamespace="http://knu.ua/pis/shchyt-link" exporter="tools/bpmn_model.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_d7_readiness">
    <bpmn:participant id="P3c7" name="Виконання місії перехоплення"/>
    <bpmn:participant id="X_SUP" name="Постачальник перехоплювачів і АКБ"/>
    <bpmn:participant id="P5" name="Забезпечення готовності ресурсів" processRef="Proc_P5"/>
    <bpmn:messageFlow id="MF_d7_readiness_0" sourceRef="P3c7" targetRef="P5_s" name="Дані про витрату"/>
    <bpmn:messageFlow id="MF_d7_readiness_1" sourceRef="P5_t5" targetRef="X_SUP" name="Заявка на поповнення"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_P5" isExecutable="false">
    <bpmn:laneSet id="LS_P5">
      <bpmn:lane id="P5_L1" name="Командир розрахунку">
        <bpmn:flowNodeRef>P5_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P5_L2" name="Технік служби">
        <bpmn:flowNodeRef>P5_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P5_L3" name="Логіст">
        <bpmn:flowNodeRef>P5_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P5_s" name="Місію завершено"><bpmn:outgoing>SF_P5_0</bpmn:outgoing><bpmn:messageEventDefinition id="ED_P5_s"/></bpmn:startEvent>
    <bpmn:userTask id="P5_t1" name="Доповісти про витрату і стан техніки"><bpmn:incoming>SF_P5_0</bpmn:incoming><bpmn:outgoing>SF_P5_1</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="P5_t2" name="Провести післяпольотний контроль"><bpmn:incoming>SF_P5_1</bpmn:incoming><bpmn:outgoing>SF_P5_2</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="P5_g1" name="Є несправності?"><bpmn:incoming>SF_P5_2</bpmn:incoming><bpmn:outgoing>SF_P5_3</bpmn:outgoing><bpmn:outgoing>SF_P5_4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="P5_t3" name="Відремонтувати або списати техніку"><bpmn:incoming>SF_P5_3</bpmn:incoming><bpmn:outgoing>SF_P5_5</bpmn:outgoing></bpmn:manualTask>
    <bpmn:serviceTask id="P5_t4" name="Оновити облік запасів і готовності"><bpmn:incoming>SF_P5_4</bpmn:incoming><bpmn:incoming>SF_P5_5</bpmn:incoming><bpmn:outgoing>SF_P5_6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P5_g2" name="Запас нижче норми?"><bpmn:incoming>SF_P5_6</bpmn:incoming><bpmn:outgoing>SF_P5_7</bpmn:outgoing><bpmn:outgoing>SF_P5_8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="P5_t5" name="Сформувати заявку на поповнення"><bpmn:incoming>SF_P5_7</bpmn:incoming><bpmn:outgoing>SF_P5_9</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="P5_e2" name="Заявку надіслано"><bpmn:incoming>SF_P5_9</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P5_e1" name="Готовність підтверджено"><bpmn:incoming>SF_P5_8</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_P5_0" sourceRef="P5_s" targetRef="P5_t1" name=""/>
    <bpmn:sequenceFlow id="SF_P5_1" sourceRef="P5_t1" targetRef="P5_t2" name=""/>
    <bpmn:sequenceFlow id="SF_P5_2" sourceRef="P5_t2" targetRef="P5_g1" name=""/>
    <bpmn:sequenceFlow id="SF_P5_3" sourceRef="P5_g1" targetRef="P5_t3" name="так"/>
    <bpmn:sequenceFlow id="SF_P5_4" sourceRef="P5_g1" targetRef="P5_t4" name="ні"/>
    <bpmn:sequenceFlow id="SF_P5_5" sourceRef="P5_t3" targetRef="P5_t4" name=""/>
    <bpmn:sequenceFlow id="SF_P5_6" sourceRef="P5_t4" targetRef="P5_g2" name=""/>
    <bpmn:sequenceFlow id="SF_P5_7" sourceRef="P5_g2" targetRef="P5_t5" name="так"/>
    <bpmn:sequenceFlow id="SF_P5_8" sourceRef="P5_g2" targetRef="P5_e1" name="ні"/>
    <bpmn:sequenceFlow id="SF_P5_9" sourceRef="P5_t5" targetRef="P5_e2" name=""/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Dgm_d7_readiness"><bpmndi:BPMNPlane id="Plane_d7_readiness" bpmnElement="Collab_d7_readiness">
    <bpmndi:BPMNShape id="P3c7_di" bpmnElement="P3c7" isHorizontal="true"><dc:Bounds x="0" y="0" width="488" height="64"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="X_SUP_di" bpmnElement="X_SUP" isHorizontal="true"><dc:Bounds x="480" y="0" width="572" height="64"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P5_di" bpmnElement="P5" isHorizontal="true"><dc:Bounds x="0" y="104" width="1052" height="354"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P5_L1_di" bpmnElement="P5_L1" isHorizontal="true"><dc:Bounds x="50" y="104" width="1002" height="118"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P5_L2_di" bpmnElement="P5_L2" isHorizontal="true"><dc:Bounds x="50" y="222" width="1002" height="118"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P5_L3_di" bpmnElement="P5_L3" isHorizontal="true"><dc:Bounds x="50" y="340" width="1002" height="118"/></bpmndi:BPMNShape>
