    <bpmndi:BPMNEdge id="SF_P3b_4_di" bpmnElement="SF_P3b_4"><di:waypoint x="658" y="281"/><di:waypoint x="668" y="281"/><di:waypoint x="668" y="163"/><di:waypoint x="678" y="163"/></bpmndi:BPMNEdge>
