<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_d5_mission_b" targetNamespace="http://knu.ua/pis/shchyt-link" exporter="tools/bpmn_model.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_d5_mission_b">
    <bpmn:participant id="P4c" name="Оцінка результату та звітність"/>
    <bpmn:participant id="P3b" name="Виконання місії перехоплення (частина 2)" processRef="Proc_P3b"/>
    <bpmn:messageFlow id="MF_d5_mission_b_0" sourceRef="P3b_t3" targetRef="P4c" name="Доповідь про результат"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_P3b" isExecutable="false">
    <bpmn:laneSet id="LS_P3b">
      <bpmn:lane id="P3b_L1" name="Командир розрахунку">
        <bpmn:flowNodeRef>P3b_t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P3b_L2" name="Оператор перехоплювача">
        <bpmn:flowNodeRef>P3b_lk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3b_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3b_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3b_t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P3b_L3" name="Технік розрахунку">
        <bpmn:flowNodeRef>P3b_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3b_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:intermediateCatchEvent id="P3b_lk" name="З частини 1 (Б)"><bpmn:outgoing>SF_P3b_0</bpmn:outgoing><bpmn:linkEventDefinition id="ED_P3b_lk" name="Б"/></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="P3b_t1" name="Здійснити пуск і вивести на ціль"><bpmn:incoming>SF_P3b_0</bpmn:incoming><bpmn:outgoing>SF_P3b_1</bpmn:outgoing><bpmn:dataOutputAssociation id="DOA_P3b_t1_0"><bpmn:targetRef>P3b_d1</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask>
    <bpmn:exclusiveGateway id="P3b_g1" name="Ціль виявлено?"><bpmn:incoming>SF_P3b_1</bpmn:incoming><bpmn:outgoing>SF_P3b_2</bpmn:outgoing><bpmn:outgoing>SF_P3b_3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P3b_t2" name="Підтвердити ціль у фазі наведення"><bpmn:incoming>SF_P3b_2</bpmn:incoming><bpmn:outgoing>SF_P3b_4</bpmn:outgoing></bpmn:userTask>
    <bpmn:sendTask id="P3b_t3" name="Доповісти про результат"><bpmn:incoming>SF_P3b_3</bpmn:incoming><bpmn:incoming>SF_P3b_4</bpmn:incoming><bpmn:outgoing>SF_P3b_5</bpmn:outgoing></bpmn:sendTask>
    <bpmn:manualTask id="P3b_t4" name="Повернути або списати перехоплювач"><bpmn:incoming>SF_P3b_5</bpmn:incoming><bpmn:outgoing>SF_P3b_6</bpmn:outgoing></bpmn:manualTask>
    <bpmn:endEvent id="P3b_e" name="Місію завершено"><bpmn:incoming>SF_P3b_6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_P3b_0" sourceRef="P3b_lk" targetRef="P3b_t1" name=""/>
    <bpmn:sequenceFlow id="SF_P3b_1" sourceRef="P3b_t1" targetRef="P3b_g1" name=""/>
    <bpmn:sequenceFlow id="SF_P3b_2" sourceRef="P3b_g1" targetRef="P3b_t2" name="так"/>
    <bpmn:sequenceFlow id="SF_P3b_3" sourceRef="P3b_g1" targetRef="P3b_t3" name="ні"/>
    <bpmn:sequenceFlow id="SF_P3b_4" sourceRef="P3b_t2" targetRef="P3b_t3" name=""/>
    <bpmn:sequenceFlow id="SF_P3b_5" sourceRef="P3b_t3" targetRef="P3b_t4" name=""/>
    <bpmn:sequenceFlow id="SF_P3b_6" sourceRef="P3b_t4" targetRef="P3b_e" name=""/>
    <bpmn:dataStoreReference id="P3b_d1" name="Архів телеметрії"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Dgm_d5_mission_b"><bpmndi:BPMNPlane id="Plane_d5_mission_b" bpmnElement="Collab_d5_mission_b">
