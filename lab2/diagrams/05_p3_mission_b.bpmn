    <bpmndi:BPMNShape id="P3b_L2_di" bpmnElement="P3b_L2" isHorizontal="true"><dc:Bounds x="50" y="222" width="906" height="118"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P3b_L3_di" bpmnElement="P3b_L3" isHorizontal="true"><dc:Bounds x="50" y="340" width="906" height="118"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P3b_lk_di" bpmnElement="P3b_lk"><dc:Bounds x="136" y="261" width="40" height="40"/><bpmndi:BPMNLabel><dc:Bounds x="104" y="304" width="104" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
