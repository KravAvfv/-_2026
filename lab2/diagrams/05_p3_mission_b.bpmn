    <bpmndi:BPMNShape id="P3b_d1_di" bpmnElement="P3b_d1"><dc:Bounds x="269" y="374" width="54" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="226" y="428" width="140" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
