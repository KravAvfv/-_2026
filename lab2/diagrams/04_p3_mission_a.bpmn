<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_d4_mission_a" targetNamespace="http://knu.ua/pis/shchyt-link" exporter="tools/bpmn_model.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_d4_mission_a">
    <bpmn:participant id="P2c4" name="Призначення цілі та санкціонування пуску"/>
    <bpmn:participant id="P3" name="Виконання місії перехоплення (частина 1)" processRef="Proc_P3"/>
    <bpmn:messageFlow id="MF_d4_mission_a_0" sourceRef="P2c4" targetRef="P3_s" name="Бойове завдання"/>
    <bpmn:messageFlow id="MF_d4_mission_a_1" sourceRef="P3_ia" targetRef="P2c4" name="Підтвердження прийняття"/>
    <bpmn:messageFlow id="MF_d4_mission_a_2" sourceRef="P3_er" targetRef="P2c4" name="Відмова"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_P3" isExecutable="false">
    <bpmn:laneSet id="LS_P3">
      <bpmn:lane id="P3_L1" name="Командир розрахунку">
        <bpmn:flowNodeRef>P3_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_ia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_er</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P3_L2" name="Оператор перехоплювача">
        <bpmn:flowNodeRef>P3_p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_p2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_lk</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P3_L3" name="Технік розрахунку">
        <bpmn:flowNodeRef>P3_t3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P3_s" name="Завдання отримано"><bpmn:outgoing>SF_P3_0</bpmn:outgoing><bpmn:messageEventDefinition id="ED_P3_s"/></bpmn:startEvent>
    <bpmn:userTask id="P3_t1" name="Оцінити можливість виконання"><bpmn:incoming>SF_P3_0</bpmn:incoming><bpmn:outgoing>SF_P3_1</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P3_g1" name="Приймається?"><bpmn:incoming>SF_P3_1</bpmn:incoming><bpmn:outgoing>SF_P3_2</bpmn:outgoing><bpmn:outgoing>SF_P3_3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="P3_ia" name="Прийняття"><bpmn:incoming>SF_P3_2</bpmn:incoming><bpmn:outgoing>SF_P3_4</bpmn:outgoing><bpmn:messageEventDefinition id="ED_P3_ia"/></bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="P3_er" name="Відмова"><bpmn:incoming>SF_P3_3</bpmn:incoming><bpmn:messageEventDefinition id="ED_P3_er"/></bpmn:endEvent>
    <bpmn:parallelGateway id="P3_p1" name=""><bpmn:incoming>SF_P3_4</bpmn:incoming><bpmn:outgoing>SF_P3_5</bpmn:outgoing><bpmn:outgoing>SF_P3_6</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="P3_t2" name="Підготувати маршрут і канал керування"><bpmn:incoming>SF_P3_5</bpmn:incoming><bpmn:outgoing>SF_P3_7</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="P3_t3" name="Виконати передпольотний контроль"><bpmn:incoming>SF_P3_6</bpmn:incoming><bpmn:outgoing>SF_P3_8</bpmn:outgoing></bpmn:manualTask>
    <bpmn:parallelGateway id="P3_p2" name=""><bpmn:incoming>SF_P3_7</bpmn:incoming><bpmn:incoming>SF_P3_8</bpmn:incoming><bpmn:outgoing>SF_P3_9</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:intermediateThrowEvent id="P3_lk" name="До частини 2 (Б)"><bpmn:incoming>SF_P3_9</bpmn:incoming><bpmn:linkEventDefinition id="ED_P3_lk" name="Б"/></bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="SF_P3_0" sourceRef="P3_s" targetRef="P3_t1" name=""/>
    <bpmn:sequenceFlow id="SF_P3_1" sourceRef="P3_t1" targetRef="P3_g1" name=""/>
    <bpmn:sequenceFlow id="SF_P3_2" sourceRef="P3_g1" targetRef="P3_ia" name="так"/>
    <bpmn:sequenceFlow id="SF_P3_3" sourceRef="P3_g1" targetRef="P3_er" name="ні"/>
    <bpmn:sequenceFlow id="SF_P3_4" sourceRef="P3_ia" targetRef="P3_p1" name=""/>
    <bpmn:sequenceFlow id="SF_P3_5" sourceRef="P3_p1" targetRef="P3_t2" name=""/>
    <bpmn:sequenceFlow id="SF_P3_6" sourceRef="P3_p1" targetRef="P3_t3" name=""/>
    <bpmn:sequenceFlow id="SF_P3_7" sourceRef="P3_t2" targetRef="P3_p2" name=""/>
    <bpmn:sequenceFlow id="SF_P3_8" sourceRef="P3_t3" targetRef="P3_p2" name=""/>
    <bpmn:sequenceFlow id="SF_P3_9" sourceRef="P3_p2" targetRef="P3_lk" name=""/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Dgm_d4_mission_a"><bpmndi:BPMNPlane id="Plane_d4_mission_a" bpmnElement="Collab_d4_mission_a">
    <bpmndi:BPMNShape id="P2c4_di" bpmnElement="P2c4" isHorizontal="true"><dc:Bounds x="0" y="0" width="1060" height="64"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P3_di" bpmnElement="P3" isHorizontal="true"><dc:Bounds x="0" y="104" width="1060" height="472"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P3_L1_di" bpmnElement="P3_L1" isHorizontal="true"><dc:Bounds x="50" y="104" width="1010" height="236"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P3_L2_di" bpmnElement="P3_L2" isHorizontal="true"><dc:Bounds x="50" y="340" width="1010" height="118"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P3_L3_di" bpmnElement="P3_L3" isHorizontal="true"><dc:Bounds x="50" y="458" width="1010" height="118"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P3_s_di" bpmnElement="P3_s"><dc:Bounds x="136" y="143" width="40" height="40"/><bpmndi:BPMNLabel><dc:Bounds x="104" y="186" width="104" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P3_t1_di" bpmnElement="P3_t1"><dc:Bounds x="214" y="119" width="164" height="88"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P3_g1_di" bpmnElement="P3_g1"><dc:Bounds x="409" y="136" width="54" height="54"/><bpmndi:BPMNLabel><dc:Bounds x="356" y="113" width="160" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P3_ia_di" bpmnElement="P3_ia"><dc:Bounds x="512" y="143" width="40" height="40"/><bpmndi:BPMNLabel><dc:Bounds x="480" y="186" width="104" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P3_er_di" bpmnElement="P3_er"><dc:Bounds x="512" y="261" width="40" height="40"/><bpmndi:BPMNLabel><dc:Bounds x="480" y="304" width="104" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P3_p1_di" bpmnElement="P3_p1"><dc:Bounds x="601" y="372" width="54" height="54"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P3_t2_di" bpmnElement="P3_t2"><dc:Bounds x="686" y="355" width="164" height="88"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P3_t3_di" bpmnElement="P3_t3"><dc:Bounds x="686" y="473" width="164" height="88"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P3_p2_di" bpmnElement="P3_p2"><dc:Bounds x="881" y="372" width="54" height="54"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P3_lk_di" bpmnElement="P3_lk"><dc:Bounds x="984" y="379" width="40" height="40"/><bpmndi:BPMNLabel><dc:Bounds x="952" y="422" width="104" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="SF_P3_0_di" bpmnElement="SF_P3_0"><di:waypoint x="176" y="163"/><di:waypoint x="214" y="163"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_P3_1_di" bpmnElement="SF_P3_1"><di:waypoint x="378" y="163"/><di:waypoint x="409" y="163"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_P3_2_di" bpmnElement="SF_P3_2"><di:waypoint x="463" y="163"/><di:waypoint x="512" y="163"/><bpmndi:BPMNLabel><dc:Bounds x="469" y="141" width="32" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_P3_3_di" bpmnElement="SF_P3_3"><di:waypoint x="436" y="190"/><di:waypoint x="436" y="281"/><di:waypoint x="512" y="281"/><bpmndi:BPMNLabel><dc:Bounds x="441" y="192" width="23" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_P3_4_di" bpmnElement="SF_P3_4"><di:waypoint x="552" y="163"/><di:waypoint x="628" y="163"/><di:waypoint x="628" y="372"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_P3_5_di" bpmnElement="SF_P3_5"><di:waypoint x="655" y="399"/><di:waypoint x="686" y="399"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_P3_6_di" bpmnElement="SF_P3_6"><di:waypoint x="628" y="426"/><di:waypoint x="628" y="517"/><di:waypoint x="686" y="517"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_P3_7_di" bpmnElement="SF_P3_7"><di:waypoint x="850" y="399"/><di:waypoint x="881" y="399"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_P3_8_di" bpmnElement="SF_P3_8"><di:waypoint x="850" y="517"/><di:waypoint x="908" y="517"/><di:waypoint x="908" y="426"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_P3_9_di" bpmnElement="SF_P3_9"><di:waypoint x="935" y="399"/><di:waypoint x="984" y="399"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="MF_d4_mission_a_0_di" bpmnElement="MF_d4_mission_a_0"><di:waypoint x="156" y="64"/><di:waypoint x="156" y="143"/><bpmndi:BPMNLabel><dc:Bounds x="162" y="73" width="129" height="22"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="MF_d4_mission_a_1_di" bpmnElement="MF_d4_mission_a_1"><di:waypoint x="532" y="143"/><di:waypoint x="532" y="64"/><bpmndi:BPMNLabel><dc:Bounds x="328" y="73" width="198" height="22"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="MF_d4_mission_a_2_di" bpmnElement="MF_d4_mission_a_2"><di:waypoint x="552" y="281"/><di:waypoint x="568" y="281"/><di:waypoint x="568" y="64"/><bpmndi:BPMNLabel><dc:Bounds x="574" y="73" width="60" height="22"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
