%% Граф переходів оператора F: X × U → X (задача 1)
graph TB
  x0(["x0: нормальний<br/>захищений"])
  x1(["x1: деградація<br/>(аномалія)"])
  x2(["x2: автономний<br/>безпечний"])
  x3(["x3: несанкціоноване<br/>втручання"])
  x4(["x4: аварійне<br/>відновлення"])
  x0 -- "u10, u12 виявлено" --> x1
  x0 -- "u6: зникла напруга ОСР" --> x2
  x1 -- "u11, u13 відбито" --> x2
  x1 -- "аномалію усунено" --> x0
  x1 -- "u11, u13 успішні" --> x3
  x2 -- "канал відновлено" --> x0
  x3 -- "інцидент виявлено" --> x4
  x4 -- "відновлено" --> x0
  style x3 stroke-width:3px,stroke-dasharray:6 3
