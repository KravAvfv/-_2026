%% Етап 2, частина 1: технологічний сегмент
graph TB
  classDef cut stroke:#000,stroke-width:4px;
  subgraph L1["Виконавчі пристрої"]
    N1["Н1<br/>Інвертори<br/>СЕС"]
    N2["Н2<br/>УЗЕ і BMS"]
    N3["Н3<br/>Зарядні<br/>станції EV"]
    N4["Н4<br/>Реле<br/>навантажень"]
  end
  N7["Н7<br/>Контролер<br/>мікромережі"]
  subgraph L3["Облік, датчики, комутація, зв'язок"]
    E5["Е5<br/>УЗПД"]
    N6["Н6<br/>Датчики<br/>середовища"]
    N5["Н5<br/>Апарат ТСП"]
    N8["Н8<br/>Шлюз<br/>безпеки"]
    E1["Е1<br/>Лічильники<br/>(75)"]
  end
  PPKO(["ППКО"])
  E5 -- "RS-485, HLS" --- E1
  N7 -. "Ethernet" .- E5
  N1 -. "Modbus TCP" .- N7
