@startuml
hide circle
skinparam linetype ortho
entity "Повітряний трек" as TRK {
  * код треку «PK»
  --
  номер треку
  належність
  оцінка загрози
}
entity "Позиція" as POS {
  * код позиції «PK»
  --
  код сектора «FK»
  умовний номер
}
entity "Розрахунок" as CRW {
  * код розрахунку «PK»
  --
  код позиції «FK»
  позивний, стан
}
entity "Перехоплювач" as INT {
  * код перехоплювача «PK»
  --
  код позиції «FK»
  серійний номер, стан
}
entity "Місія" as MIS {
  * код місії «PK»
  --
  код треку «FK»
  код розрахунку «FK»
  код перехоплювача «FK»
  санкціонував «FK»
  стан, результат
}
entity "Звіт про перехоплення" as REP {
  * код звіту «PK»
  --
  код місії «FK»
  оцінка результату
}
entity "Користувач" as USR {
  * код користувача «PK»
  --
  код ролі «FK»
  код розрахунку «FK»
  ПІБ, статус
}
entity "Роль" as ROL {
  * код ролі «PK»
  --
  назва ролі
}
POS ||--o{ CRW : розміщує
POS ||--o{ INT : зберігає
TRK ||--o{ MIS : ціль
CRW ||--o{ MIS : виконує
INT |o--o{ MIS : застосовується
MIS ||--o| REP : підсумовує
ROL ||--o{ USR : надає права
CRW |o--o{ USR : включає
USR ||--o{ MIS : санкціонує
@enduml
