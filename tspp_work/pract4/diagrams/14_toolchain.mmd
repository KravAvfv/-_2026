  T1["Редактор і рендерер<br/>bpmn-js"]:::tool
  T2["Генератор IDEF0<br/>(нотація AllFusion PM)"]:::tool
  T3["PlantUML"]:::tool
  T4["Генератор SQL DDL<br/>(пряме проектування)"]:::tool
  T5["Контроль<br/>читабельності<br/>(≥ 10 пт, ≥ 300 dpi)"]:::tool

