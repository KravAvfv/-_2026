<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_b1_picture" targetNamespace="http://knu.ua/pis/shchyt-link" exporter="tools/bpmn_model.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_b1_picture">
    <bpmn:participant id="SEN" name="Сенсорна мережа (акустичні вузли, РЛС, пости ОЕП)"/>
    <bpmn:participant id="ORG" name="РЦПДО «Щит-Північ» з IoT-платформою «Щит-Лінк» (як буде)" processRef="Proc_ORG"/>
    <bpmn:messageFlow id="MF_b1_picture_0" sourceRef="SEN" targetRef="s" name="Виявлення"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_ORG" isExecutable="false">
    <bpmn:laneSet id="LS_ORG">
      <bpmn:lane id="L_GW" name="Периферійний шлюз">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_CORE" name="IoT-ядро">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_AN" name="Аналітик обстановки">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Виявлення надійшло"><bpmn:outgoing>SF_ORG_0</bpmn:outgoing><bpmn:messageEventDefinition id="ED_s"/></bpmn:startEvent>
    <bpmn:serviceTask id="t1" name="Перевірити джерело й нормалізувати"><bpmn:incoming>SF_ORG_0</bpmn:incoming><bpmn:outgoing>SF_ORG_1</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Дані коректні?"><bpmn:incoming>SF_ORG_1</bpmn:incoming><bpmn:outgoing>SF_ORG_2</bpmn:outgoing><bpmn:outgoing>SF_ORG_3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t2" name="Злити виявлення в трек"><bpmn:incoming>SF_ORG_3</bpmn:incoming><bpmn:outgoing>SF_ORG_4</bpmn:outgoing><bpmn:dataOutputAssociation id="DOA_t2_0"><bpmn:targetRef>d1</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
    <bpmn:endEvent id="e0" name="Відхилено"><bpmn:incoming>SF_ORG_2</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="t3" name="Запропонувати тип і оцінити загрозу"><bpmn:incoming>SF_ORG_4</bpmn:incoming><bpmn:outgoing>SF_ORG_5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="t4" name="Підтвердити класифікацію"><bpmn:incoming>SF_ORG_5</bpmn:incoming><bpmn:outgoing>SF_ORG_6</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name="Ворожа ціль?"><bpmn:incoming>SF_ORG_6</bpmn:incoming><bpmn:outgoing>SF_ORG_7</bpmn:outgoing><bpmn:outgoing>SF_ORG_8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="e1" name="Ціль у черзі"><bpmn:incoming>SF_ORG_7</bpmn:incoming><bpmn:messageEventDefinition id="ED_e1"/></bpmn:endEvent>
    <bpmn:endEvent id="e2" name="Спостереження"><bpmn:incoming>SF_ORG_8</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_ORG_0" sourceRef="s" targetRef="t1" name=""/>
    <bpmn:sequenceFlow id="SF_ORG_1" sourceRef="t1" targetRef="g1" name=""/>
    <bpmn:sequenceFlow id="SF_ORG_2" sourceRef="g1" targetRef="e0" name="ні"/>
    <bpmn:sequenceFlow id="SF_ORG_3" sourceRef="g1" targetRef="t2" name="так"/>
    <bpmn:sequenceFlow id="SF_ORG_4" sourceRef="t2" targetRef="t3" name=""/>
    <bpmn:sequenceFlow id="SF_ORG_5" sourceRef="t3" targetRef="t4" name=""/>
    <bpmn:sequenceFlow id="SF_ORG_6" sourceRef="t4" targetRef="g2" name=""/>
    <bpmn:sequenceFlow id="SF_ORG_7" sourceRef="g2" targetRef="e1" name="так"/>
    <bpmn:sequenceFlow id="SF_ORG_8" sourceRef="g2" targetRef="e2" name="ні"/>
    <bpmn:dataStoreReference id="d1" name="Сховище треків"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Dgm_b1_picture"><bpmndi:BPMNPlane id="Plane_b1_picture" bpmnElement="Collab_b1_picture">
    <bpmndi:BPMNShape id="SEN_di" bpmnElement="SEN" isHorizontal="true"><dc:Bounds x="0" y="0" width="1044" height="64"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="ORG_di" bpmnElement="ORG" isHorizontal="true"><dc:Bounds x="0" y="104" width="1044" height="472"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_GW_di" bpmnElement="L_GW" isHorizontal="true"><dc:Bounds x="50" y="104" width="994" height="118"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_CORE_di" bpmnElement="L_CORE" isHorizontal="true"><dc:Bounds x="50" y="222" width="994" height="118"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_AN_di" bpmnElement="L_AN" isHorizontal="true"><dc:Bounds x="50" y="340" width="994" height="236"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="136" y="143" width="40" height="40"/><bpmndi:BPMNLabel><dc:Bounds x="104" y="186" width="104" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="214" y="119" width="164" height="88"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="g1_di" bpmnElement="g1"><dc:Bounds x="453" y="136" width="54" height="54"/><bpmndi:BPMNLabel><dc:Bounds x="400" y="113" width="160" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="398" y="237" width="164" height="88"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="e0_di" bpmnElement="e0"><dc:Bounds x="644" y="143" width="40" height="40"/><bpmndi:BPMNLabel><dc:Bounds x="612" y="186" width="104" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="582" y="237" width="164" height="88"/></bpmndi:BPMNShape>
