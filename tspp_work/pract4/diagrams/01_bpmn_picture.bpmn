    <bpmndi:BPMNEdge id="DOA_t2_0_di" bpmnElement="DOA_t2_0"><di:waypoint x="480" y="237"/><di:waypoint x="848" y="188"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="MF_b1_picture_0_di" bpmnElement="MF_b1_picture_0"><di:waypoint x="156" y="64"/><di:waypoint x="156" y="143"/><bpmndi:BPMNLabel><dc:Bounds x="162" y="73" width="77" height="22"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
