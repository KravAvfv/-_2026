    <bpmndi:BPMNShape id="g2_di" bpmnElement="g2"><dc:Bounds x="961" y="372" width="54" height="54"/><bpmndi:BPMNLabel><dc:Bounds x="878" y="336" width="104" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="968" y="261" width="40" height="40"/><bpmndi:BPMNLabel><dc:Bounds x="936" y="304" width="104" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="e2_di" bpmnElement="e2"><dc:Bounds x="968" y="497" width="40" height="40"/><bpmndi:BPMNLabel><dc:Bounds x="928" y="540" width="120" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="d1_di" bpmnElement="d1"><dc:Bounds x="821" y="138" width="54" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="778" y="114" width="140" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="SF_ORG_0_di" bpmnElement="SF_ORG_0"><di:waypoint x="176" y="163"/><di:waypoint x="214" y="163"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_ORG_1_di" bpmnElement="SF_ORG_1"><di:waypoint x="378" y="163"/><di:waypoint x="453" y="163"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_ORG_2_di" bpmnElement="SF_ORG_2"><di:waypoint x="507" y="163"/><di:waypoint x="644" y="163"/><bpmndi:BPMNLabel><dc:Bounds x="513" y="141" width="23" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_ORG_3_di" bpmnElement="SF_ORG_3"><di:waypoint x="480" y="190"/><di:waypoint x="480" y="237"/><bpmndi:BPMNLabel><dc:Bounds x="485" y="192" width="32" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_ORG_4_di" bpmnElement="SF_ORG_4"><di:waypoint x="562" y="281"/><di:waypoint x="582" y="281"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_ORG_5_di" bpmnElement="SF_ORG_5"><di:waypoint x="746" y="281"/><di:waypoint x="756" y="281"/><di:waypoint x="756" y="399"/><di:waypoint x="766" y="399"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="SF_ORG_6_di" bpmnElement="SF_ORG_6"><di:waypoint x="930" y="399"/><di:waypoint x="961" y="399"/></bpmndi:BPMNEdge>
